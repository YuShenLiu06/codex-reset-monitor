{
  "name": "Codex Reset Installer",
  "url": "https://github.com/YuShenLiu06/codex-reset-monitor",
  "description": "Local setup of Codex reset alerts for one explicitly selected repository.",
  "public": true,
  "hook_attributes": {"active": false},
  "default_permissions": {
    "contents": "read",
    "metadata": "read",
    "actions": "write",
    "secrets": "write",
    "actions_variables": "write"
